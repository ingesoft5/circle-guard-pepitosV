# Gradle
.gradle/
build/
!**/src/**/build/
**/build/

# Java
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
# The Gradle wrapper jar must be versioned so a clean clone can build.
!gradle/wrapper/gradle-wrapper.jar

# Maven
target/
**/target/

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Node/Expo (Handled in mobile/ but good to have here too)
node_modules/
.expo/
dist/
web-build/

# Docker Local Data
*_data/
pgdata/
neo4jdata/

# Secretos de infraestructura (solo se versionan las plantillas)
infra/**/*.env
!infra/**/*.env.example
deploy/**/*.env
!deploy/**/*.env.example
*.pem
*.key
infra/compose/ci/secrets/

# Terraform: providers and local state stay out of the repo (state lives in S3)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Bytecode de Python (Locust y scripts locales)
__pycache__/
*.pyc
