# Plantilla de configuración del ambiente — stage
# Ubicación final: deploy/compose/stage/.env

ENV_NAME=stage
COMPOSE_PROJECT=circleguard-stage
ENV_NETWORK=circleguard-stage-net
VOLUME_PREFIX=circleguard-stage
ENV_DOMAIN=stage.circleguard.example.edu
PORT_OFFSET=1000

# Imágenes: el pipeline fija IMAGE_TAG con la versión que despliega
IMAGE_REGISTRY=localhost:5000
IMAGE_TAG=0.1.0

# Control de acceso de red
ADMIN_CIDR=203.0.113.0/24

# Orígenes web que pueden llamar a los servicios desde otro dominio, separados por coma.
# El cliente web del ambiente no los necesita: comparte origen con los servicios.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080

# Puertos públicos
HTTP_PORT=80
HTTPS_PORT=443
AUTH_PORT=8180
NOTIFICATION_PORT=8082
IDENTITY_PORT=8083
DASHBOARD_PORT=8084
FILE_PORT=8085
FORM_PORT=8086
GATEWAY_PORT=8087
PROMOTION_PORT=8088

# Puertos internos del middleware
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
KAFKA_PORT=9092
REDIS_PORT=6379
LDAP_PORT=389
LDAPS_PORT=636

# Credenciales - se generan localmente en el primer bootstrap y nunca se versionan
POSTGRES_USER=circleguard
POSTGRES_PASSWORD=__GENERATE__
NEO4J_USER=neo4j
NEO4J_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
LDAP_ADMIN_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
QR_SECRET=__GENERATE__
VAULT_SECRET=__GENERATE__
VAULT_SALT=__GENERATE__
VAULT_HASH_SALT=__GENERATE__
