{
  "uid": "circleguard-redis-health",
  "title": "CircleGuard redisHealth circuit",
  "tags": ["circleguard", "resilience4j"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuito abierto",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(resilience4j_circuitbreaker_state{name=\"redisHealth\",state=\"open\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "decimals": 0 },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Estado de redisHealth",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (resilience4j_circuitbreaker_state{name=\"redisHealth\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tasa de fallo",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(resilience4j_circuitbreaker_failure_rate{name=\"redisHealth\"})",
          "legendFormat": "failure rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    }
  ]
}
