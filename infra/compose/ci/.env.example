# Plantilla de configuración del stack CI - Jenkins, SonarQube y Nexus
# Ubicación final: infra/compose/ci/.env

CI_PROJECT=circleguard-ci
CI_NETWORK=circleguard-ci-net
CI_DOMAIN=ci.circleguard.example.edu

# Acceso administrativo (Security Group / ufw)
ADMIN_CIDR=203.0.113.0/24

# Puertos publicados en el host CI
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
SONAR_PORT=9000
NEXUS_PORT=8081
NEXUS_REGISTRY_PORT=5000

# Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=__GENERATE__

# GitHub integration (multibranch pipeline and commit statuses)
GITHUB_OWNER=ingesoft5
GITHUB_REPO=circle-guard-pepitosV
GITHUB_USER=__SET_ME__
GITHUB_TOKEN=__SET_ME__

# Discord notifications
DISCORD_WEBHOOK_URL=__SET_ME__

# Pruebas E2E (HU-20): usuario del cliente web con el que inicia sesión Playwright.
# Los usuarios de prueba están en la migración V2__seed_test_users.sql de auth.
E2E_USERNAME=health_user
E2E_PASSWORD=__SET_ME__

# SonarQube
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=__GENERATE__
SONAR_DB_NAME=sonarqube
SONAR_ADMIN_PASSWORD=__GENERATE__
SONAR_TOKEN=

# Nexus
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=__GENERATE__

# Registro de imágenes (HU-07)
# Dirección con la que Jenkins publica: el daemon Docker es el del host CI,
# por eso es localhost. Los ambientes usan la IP privada del host CI.
NEXUS_REGISTRY=localhost:5000
IMAGE_NAMESPACE=circleguard
# Usuario de Jenkins: push y pull sobre docker-hosted
NEXUS_CI_USER=ci-publisher
NEXUS_CI_PASSWORD=__GENERATE__
# Usuario de los ambientes: solo pull (se pasa a bootstrap-env.sh)
NEXUS_PULL_USER=deploy-puller
NEXUS_PULL_PASSWORD=__GENERATE__

# Private IP of each environment host, used by the deployCompose pipeline step
DEPLOY_HOST_DEV=
DEPLOY_HOST_STAGE=
DEPLOY_HOST_PROD=

# Rama de la que el job de rollback toma su pipeline (HU-17). Solo se cambia para probarlo.
ROLLBACK_BRANCH=main
