# CircleGuard environment template — dev
# Copy this file to dev.env (without .example) or let bootstrap-env.sh generate it.
# NEVER commit the generated dev.env file.

ENV_NAME=dev
COMPOSE_PROJECT=circleguard-dev
ENV_NETWORK=circleguard-dev-net
VOLUME_PREFIX=circleguard-dev
ENV_DOMAIN=dev.circleguard.example.edu
PORT_OFFSET=0

# Network access control
ADMIN_CIDR=203.0.113.0/24

# Public ports (PORT_OFFSET is applied by the compose overrides)
HTTP_PORT=80
HTTPS_PORT=443
AUTH_PORT=8180
NOTIFICATION_PORT=8082
IDENTITY_PORT=8083
DASHBOARD_PORT=8084
FILE_PORT=8085
FORM_PORT=8086
GATEWAY_PORT=8087
PROMOTION_PORT=8088

# Internal middleware ports
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
KAFKA_PORT=9092
REDIS_PORT=6379
LDAP_PORT=389
LDAPS_PORT=636

# Credentials — generated locally on first bootstrap, never committed
POSTGRES_USER=circleguard
POSTGRES_PASSWORD=__GENERATE__
NEO4J_USER=neo4j
NEO4J_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
LDAP_ADMIN_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
QR_SECRET=__GENERATE__
VAULT_SECRET=__GENERATE__
VAULT_SALT=__GENERATE__
