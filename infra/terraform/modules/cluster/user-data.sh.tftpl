#!/usr/bin/env bash
# First boot of a CircleGuard k3s node (rendered by Terraform, module cluster).
set -Eeuo pipefail

# The Nexus registry on the tools host serves plain HTTP: containerd needs it declared.
install -d -m 755 /etc/rancher/k3s
cat > /etc/rancher/k3s/registries.yaml <<YAML
mirrors:
  "${registry}":
    endpoint:
      - "http://${registry}"
YAML

# Kubernetes expects swap off (Ubuntu cloud images have none; this keeps it that way).
swapoff -a

curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server \
  --node-name "${node_name}" \
  --tls-san "${public_ip}" \
  --write-kubeconfig-mode 600
