    {"type": "timeseries", "title": "Tiempo en GC", "description": "Fracción del tiempo que la JVM pasa en pausas de recolección.", "targets": [{"refId": "A", "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum{namespace=\"$namespace\", service=~\"$service\"}[$__rate_interval]))", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisLabel": "", "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "id": 20, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 48}, "datasource": {"type": "prometheus", "uid": "${datasource}"}},
