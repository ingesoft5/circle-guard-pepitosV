    {"type": "timeseries", "title": "Conexiones a PostgreSQL", "description": "Conexiones activas del pool Hikari (solo servicios con base de datos).", "targets": [{"refId": "A", "expr": "sum by (service) (hikaricp_connections_active{namespace=\"$namespace\", service=~\"$service\"})", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisLabel": "", "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "id": 22, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56}, "datasource": {"type": "prometheus", "uid": "${datasource}"}},
